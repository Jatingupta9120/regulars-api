# Postgres — Supabase or Neon free tier both work.
DATABASE_URL=postgresql://user:pass@host:5432/postgres?sslmode=require

# Signing key for member tokens. Generate with: openssl rand -base64 48
JWT_SECRET=

# Where a SEVERE flag is delivered. Must work when the app is down.
SAFETY_WEBHOOK_URL=
SAFETY_EMAIL=safety@regulars.nyc

# Comma-separated origins allowed to call this API.
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

PORT=4000

# Identity verification (Persona or Stripe Identity). The document never
# touches this server; only the decision and an identity hash come back.
VERIFICATION_PROVIDER=stripe-identity
VERIFICATION_HOSTED_URL=
VERIFICATION_WEBHOOK_SECRET=

# Stripe. One-time payment mode only. Never create a subscription price.
STRIPE_SECRET_KEY=
STRIPE_CHECKOUT_URL=
STRIPE_WEBHOOK_SECRET=
